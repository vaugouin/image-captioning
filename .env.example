# Anthropic API (vision captioning). Use a key from "Philippe's Individual Org"
# so the call draws on the Max plan's monthly API credit (rule credits-api-anthropic).
ANTHROPIC_API_KEY=

# Vision model. Default claude-sonnet-5-5 (grounded captioning, negligible cost).
# claude-haiku-5-5 for a full-TMDb pass; claude-opus-5-5 is overkill here.
CAPTION_MODEL=claude-sonnet-5-5

# FastAPI/FastMCP text2sql REST endpoint, for the per-film context
# (GET /movies/{id}). Same names and values as in voice-agent's .env;
# unauthenticated calls get a 401.
TEXT2SQL_BASE_URL=http://www.vaugouin.com:8187
TEXT2SQL_API_KEY_NAME=X-API-Key
TEXT2SQL_API_KEY_VALUE=

# NAS root where download-images mirrored the TMDb images.
NAS_ROOT=T:\prive\TMDb-images
# Size folder to read. Only "original" is downloaded today; the script downsizes
# locally before the API call, so reading originals is fine.
NAS_SIZE=original

# Directory holding T_WC_TMDB_MOVIE_IMAGE.csv. Canonical local mirror of the VPS
# export (/home/debian/docker/download-images/csv), refreshed by the cron export.
CSV_DIR=T:\prive\dev.ovh\ovh-pv7\home\debian\docker\download-images\csv

# Local resumable state and the SQL emitted for the VPS load (voie 2).
STATE_DB=./state.sqlite
OUT_SQL=./captions.sql
